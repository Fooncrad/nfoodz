{
  "name": "nfoodz",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "check": "npm run typecheck:client && npm run typecheck:server && vite build",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "express": "latest",
    "mysql2": "latest",
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "jsonwebtoken": "latest",
    "zod": "latest",
    "dotenv": "latest",
    "tsx": "latest",
    "qrcode": "latest",
    "multer": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/express": "latest",
    "@types/cookie-parser": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest"
  }
}
